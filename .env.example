# SurrealDB Connection Configuration
# Copy this file to .env and update with your values
#
# For Docker: Ensure docker-compose is running first:
#   docker compose up -d

# Connection string format:
#   ws://<host>:<port>/rpc
#   http://<host>:<port>
#
# With authentication:
#   http://<user>:<pass>@<host>:<port>

# =============================================================================
# NodeDriver Environment Variables
# =============================================================================
# These variables are read by the NodeDriver constructor with the following
# priority: Explicit config > Environment variable > Default value
# =============================================================================

# Connection URL for the SurrealDB instance
# Format: http://<host>:<port> or ws://<host>:<port>/rpc
# Default: ws://localhost:10101
SURREALDB_URL=ws://localhost:10101

# http endpoint URL (alternative to SURREALDB_URL, used if SURREALDB_URL is not set)
SURREALDB_HTTP_URL=http://localhost:10101

# Username for authentication (optional if no auth required)
# Default: (none)
SURREALDB_USER=admin

# Password for authentication (optional if no auth required)
# Default: (none)
SURREALDB_PASS=admin

# Namespace to use after connection
# Default: default
SURREALDB_NAMESPACE=test

# Database to use after connection
# Default: default
SURREALDB_DATABASE=test

# =============================================================================
# Other Configuration (not used by NodeDriver)
# =============================================================================

# Embedded instance (alternative)
# SURREALDB_PATH=./data/surreal.db
