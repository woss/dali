{
  "name": "dali-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "format": "biome format",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "crg": "test -z \"$CI\" && code-review-graph daemon add . && code-review-graph daemon start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dotenv": "^17.4.1",
    "surrealdb": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "@biomejs/biome": "2.5.10",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.1.2",
  "dependencies": {}
}
