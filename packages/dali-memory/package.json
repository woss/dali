    "orm": "dali-orm"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@logtape/file": "2.1.1",
    "@logtape/logtape": "2.1.1",
    "@logtape/pretty": "2.1.1",
    "@modelcontextprotocol/sdk": "^1.17.0",
    "@sveltejs/adapter-node": "^5.2.0",
    "@sveltejs/kit": "^2.20.0",
    "@tailwindcss/vite": "^4.1.0",
    "@woss/dali-orm": "workspace:*",
    "daisyui": "5.6.0-beta.0",
    "surrealdb": "catalog:",
    "tailwindcss": "^4.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/jsdom": "^28.0.3",
    "jsdom": "^29.1.1",
    "svelte": "^5.25.0",
    "svelte-check": "^4.0.0",
    "typescript": "catalog:",
    "vite": "^6.0.0",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=18.0.0"
  }
