{
  "name": "@woss/dali-memory",
  "version": "0.4.0",
  "description": "Standalone MCP memory server with SurrealDB, hybrid search, and Web UI",
  "keywords": [
    "mcp",
    "memory",
    "surrealdb",
    "sveltekit",
    "tailwind"
  ],
  "homepage": "https://github.com/woss/dali#readme",
  "bugs": {
    "url": "https://github.com/woss/dali/issues"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woss/dali.git",
    "directory": "packages/dali-memory"
  },
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
