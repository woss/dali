{
  "$schema": "https://jsr.io/schema/config-file.v1.json",
  "name": "@woss/dali-orm",
  "version": "0.4.0",
  "license": "GPL-3.0-only",
  "exports": {
    ".": "./src/index.ts",
    "./core/errors": "./src/core/errors.ts",
    "./core/surql": "./src/core/surql.ts",
    "./migration/api": "./src/migration/api.ts",
    "./migration/cli": "./src/migration/cli.ts",
    "./query": "./src/query/index.ts",
    "./sdk/dali-orm": "./src/sdk/dali-orm.ts",
    "./sdk/schema": "./src/sdk/schema.ts",
    "./sdk/table": "./src/sdk/table.ts"
  },
  "imports": {
    "@surrealdb/node": "npm:@surrealdb/node@3.0.3",
    "obug": "npm:obug@2.1.1",
    "surrealdb": "npm:surrealdb@2.0.3",
    "valibot": "npm:valibot@1.3.1"
  },
  "publish": {
    "include": ["src/**/*.ts", "README.md", "CHANGELOG.md"],
    "exclude": [
      "src/**/__tests__/**",
      "src/**/*.test.ts",
      "src/**/*.d.ts",
      "tmp"
    ]
  }
}
