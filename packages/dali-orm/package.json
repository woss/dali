{
  "name": "@woss/dali-orm",
  "version": "0.4.0",
  "description": "Type-safe ORM for SurrealDB with migration support",
  "keywords": [
    "migrations",
    "orm",
    "surrealdb",
    "type-safe",
    "typescript"
  ],
  "homepage": "https://github.com/woss/dali#readme",
  "bugs": {
    "url": "https://github.com/woss/dali/issues"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woss/dali.git",
    "directory": "packages/dali-orm"
  },
  "bin": {
    "dali-orm": "./dist/migration/cli.mjs"
  },
  "files": [
    "CHANGELOG.md",
    "README.md",
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    },
    "./core/errors": {
      "import": "./dist/core/errors.mjs",
      "types": "./dist/core/errors.d.ts"
    },
    "./core/surql": {
      "import": "./dist/core/surql.mjs",
      "types": "./dist/core/surql.d.ts"
    },
    "./migration/api": {
      "import": "./dist/migration/api.mjs",
      "types": "./dist/migration/api.d.ts"
    },
    "./migration/cli": {
      "import": "./dist/migration/cli.mjs",
      "types": "./dist/migration/cli.d.ts"
    },
    "./migration/config": {
      "import": "./dist/migration/config.mjs",
      "types": "./dist/migration/config.d.ts"
    },
    "./query": {
      "import": "./dist/query/index.mjs",
      "types": "./dist/query/index.d.ts"
    },
    "./sdk/dali-orm": {
      "import": "./dist/sdk/dali-orm.mjs",
      "types": "./dist/sdk/dali-orm.d.ts"
    },
    "./sdk/driver/config/types": {
      "import": "./dist/sdk/driver/config/types.mjs",
      "types": "./dist/sdk/driver/config/types.d.ts"
    },
    "./sdk/functions": {
      "import": "./dist/sdk/functions/index.mjs",
      "types": "./dist/sdk/functions/index.d.ts"
    },
    "./sdk/orm-schema": {
      "import": "./dist/sdk/orm-schema.mjs",
      "types": "./dist/sdk/orm-schema.d.ts"
    },
    "./sdk/schema": {
      "import": "./dist/sdk/schema.mjs",
      "types": "./dist/sdk/schema.d.ts"
    },
    "./sdk/schema/column/record": {
      "import": "./dist/sdk/schema/column/record.mjs",
      "types": "./dist/sdk/schema/column/record.d.ts"
    },
    "./sdk/schema/column/simple-builders": {
      "import": "./dist/sdk/schema/column/simple-builders.mjs",
      "types": "./dist/sdk/schema/column/simple-builders.d.ts"
    },
    "./sdk/table": {
      "import": "./dist/sdk/table.mjs",
      "types": "./dist/sdk/table.d.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build && pnpm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@surrealdb/node": "catalog:",
    "obug": "catalog:",
    "surrealdb": "catalog:",
    "tsx": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.0",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
