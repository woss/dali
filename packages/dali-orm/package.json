{
  "name": "@woss/dali-orm",
  "version": "0.3.1",
  "description": "Type-safe ORM for SurrealDB with migration support",
  "keywords": [
    "migrations",
    "orm",
    "surrealdb",
    "type-safe",
    "typescript"
  ],
  "homepage": "https://github.com/woss/dali#readme",
  "bugs": {
    "url": "https://github.com/woss/dali/issues"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woss/dali.git",
    "directory": "packages/dali-orm"
  },
  "bin": {
    "dali-orm": "./dist/migration/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.mjs",
    "./core/errors": "./dist/core/errors.mjs",
    "./core/surql": "./dist/core/surql.mjs",
    "./migration/api": "./dist/migration/api.mjs",
    "./migration/cli": "./dist/migration/cli.mjs",
    "./migration/config": "./dist/migration/config.mjs",
    "./query": "./dist/query/index.mjs",
    "./sdk/dali-orm": "./dist/sdk/dali-orm.mjs",
    "./sdk/driver/config/types": "./dist/sdk/driver/config/types.mjs",
    "./sdk/functions": "./dist/sdk/functions/index.mjs",
    "./sdk/orm-schema": "./dist/sdk/orm-schema.mjs",
    "./sdk/schema": "./dist/sdk/schema.mjs",
    "./sdk/schema/column/record": "./dist/sdk/schema/column/record.mjs",
    "./sdk/schema/column/simple-builders": "./dist/sdk/schema/column/simple-builders.mjs",
    "./sdk/table": "./dist/sdk/table.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@surrealdb/node": "catalog:",
    "obug": "catalog:",
    "surrealdb": "catalog:",
    "tsx": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.0",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}